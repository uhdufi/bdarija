{
  "name": "bdarija",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-12",
  "workers_dev": true,
  "rules": [
    { "type": "Text", "globs": ["**/*.html"], "fallthrough": true }
  ],
  "ratelimits": [
    {
      "name": "BDARIJA_LIMIT",
      "namespace_id": "1002",
      "simple": { "limit": 10, "period": 60 }
    }
  ]
}
